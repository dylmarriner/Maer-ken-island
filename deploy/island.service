# The island's backend as a systemd service.
#
#   deploy/build-release.sh
#   install -m 0755 dist/bin/island /usr/local/bin/
#   cp -r dist/share/island /usr/local/share/
#   useradd --system --home /var/lib/island island
#   install -m 0644 deploy/island.service /etc/systemd/system/
#   install -m 0600 deploy/island.env     /etc/island/island.env   # and fill it in
#   systemctl daemon-reload && systemctl enable --now island
#
# One process, one island, one simulation thread. Several frontends read
# it over HTTP; see docs/island/DEPLOYMENT.md.

[Unit]
Description=Maer-Ken Island backend
Documentation=file:///usr/share/doc/island/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=island
Group=island
EnvironmentFile=/etc/island/island.env
# Where the shipped reference packs are; the path compiled into the binary
# is the build machine's.
Environment=ISLAND_REFERENCE_DIR=/usr/local/share/island/fixtures/reference
# To run another scenario, put it (and its canon) elsewhere and name it here.
ExecStart=/usr/local/bin/island serve \
    --scenario /usr/local/share/island/fixtures/island/default_scenario.json \
    --bind ${ISLAND_BIND} \
    --data-dir /var/lib/island/people \
    --snapshot-dir /var/lib/island/snapshots \
    --autosave 30 --resume \
    --log /var/lib/island/commands.jsonl

# `island serve` stops on Ctrl-C or on systemd's SIGTERM alike: it
# finishes the step it is on, saves the island to latest.mks (--autosave)
# and exits; the next start carries on from that save (--resume). The
# timeout is generous because a save takes half a minute to well over a
# minute on the full island (74.6 s measured on a busy 4-core machine). Killing it mid-write cannot corrupt latest.mks (it is written
# beside it and renamed), but it loses everything since the previous save.
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=5

# The island writes to exactly one place and reads nothing else.
StateDirectory=island
ReadWritePaths=/var/lib/island
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# A simulated week peaks at 307 MB on the full island; this leaves room for
# a snapshot being built beside it and still catches a leak.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
