# Copy to /etc/island/island.env, mode 0600, and fill in.
# Never commit a filled-in copy of this file.

# Where to listen. 0.0.0.0 is reachable from other machines, which is the
# point -- and which makes both tokens below matter.
ISLAND_BIND=0.0.0.0:8080

# Who may change the island. Without it, writes are refused on a
# non-loopback bind.
#   openssl rand -hex 32
ISLAND_CONTROL_TOKEN=

# Who may look at it. Without it, anyone who can reach the port can read
# every person's complete record. The backend says so on startup.
ISLAND_READ_TOKEN=

# A line per request on stdout, which on a service means the journal.
# Set to `off` on a busy backend.
ISLAND_ACCESS_LOG=on

# Human records are encrypted with this. If it is unset, the island
# generates one at island-data/humans/.secret_storage_key on first run --
# back that file up, because without it the records cannot be read again.
# MK_STORAGE_KEY=

# The one thing on this island that can see out. Leave it unset: with it
# on, two runs of the same seed no longer agree.
# COMPUTER_ACTIONS_ENABLED=1
# COMPUTER_SERVICE_URL=http://127.0.0.1:8002
# COMPUTER_SERVICE_TOKEN=
