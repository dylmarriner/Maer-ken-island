# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Rotate any credential that was ever pasted into a chat, ticket, or log
# before putting it here — see docs/superpowers/specs/2026-09-11-computer-access-integration-design.md
# "Security Considerations".

PORT=8002
# Interface to listen on. The default 127.0.0.1 only accepts local callers
# (the simulation engine). Binding wider requires COMPUTER_SERVICE_TOKEN.
HOST=127.0.0.1
# Shared secret. When set, every /api/computer request must carry
# `Authorization: Bearer <token>`; the engine sends the same variable.
COMPUTER_SERVICE_TOKEN=

# One Google OAuth2 client + refresh token per agent. Generate a refresh
# token once via the standard OAuth2 installed-app consent flow (Google
# Cloud Console -> OAuth consent screen -> your client -> scope
# https://www.googleapis.com/auth/gmail.send, plus
# https://www.googleapis.com/auth/gmail.labels if GET /api/computer/:agent/state
# should report the inbox unread count) — this service never sees or stores
# the account password, only a refresh token it can revoke.
GEM_D_CLIENT_ID=
GEM_D_CLIENT_SECRET=
GEM_D_REFRESH_TOKEN=
GEM_D_EMAIL=

GEM_K_CLIENT_ID=
GEM_K_CLIENT_SECRET=
GEM_K_REFRESH_TOKEN=
GEM_K_EMAIL=

# Contact directory. The simulation only ever sends a contact identifier
# (crates/mk_engine KNOWN_CONTACTS: dylan, kirsty); each needs an address
# here. Mail to identifiers without an entry is refused.
CONTACT_DYLAN=
CONTACT_KIRSTY=
